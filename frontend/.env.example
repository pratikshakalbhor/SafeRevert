# SafeRevert Frontend Environment Variables

# The deployed address of SafeRevertVault on Ethereum Sepolia testnet
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional / legacy: no longer used. Transfers are loaded with direct contract
# reads (nextId + getTransfer), so no log-scan floor is required.
VITE_DEPLOY_BLOCK=0

# Sepolia RPC URL (e.g. Alchemy, Infura, or public RPC)
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# WalletConnect Cloud Project ID (from https://cloud.reown.com)
# Leave empty to use the browser (injected) wallet only — never commit a real id.
VITE_WALLETCONNECT_PROJECT_ID=
